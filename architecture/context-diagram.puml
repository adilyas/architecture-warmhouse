@startuml C4_Context
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml

title Контекстная диаграмма системы "Теплый дом"

Person(admin, "Администратор", "Управляет системой, подключает датчики температуры и устройства отопления")
Person(user, "Пользователь", "Контролирует температуру в помещениях и просматривает ее")

System(warmhouse, "Система Теплый дом", "Монолитное Go приложение для мониторинга и управления температурой в умном доме")

System_Ext(temp_sensors, "Датчики температуры", "Умные датчики для измерения температуры в различных помещениях")
System_Ext(heating_devices, "Устройства обогрева", "Умные термостаты и системы отопления для регулирования температуры")

Rel(admin, warmhouse, "Настраивает систему через", "HTTPS/Web UI")
Rel(user, warmhouse, "Мониторит температуру и управляет отоплением через", "HTTPS/Web UI")

Rel(warmhouse, temp_sensors, "Собирает данные о температуре", "IoT протоколы")
Rel(warmhouse, heating_devices, "Отправляет команды управления", "IoT протоколы")

SHOW_LEGEND()
@enduml